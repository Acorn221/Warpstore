# Embeds the device headers shared with runtime-compiled kernels as C++ raw string literals.
# usage: cmake -DOUT=<header> -DDEVTYPES=<devtypes.h> -DKERNELS=<kernels.cuh> -P embed.cmake
file(READ "${DEVTYPES}" A)
file(READ "${KERNELS}" B)
file(WRITE "${OUT}" "// Generated by cmake/embed.cmake. Do not edit.\n#pragma once\nnamespace gdb {\nstatic const char* const kJitDevtypesSrc = R\"GDBSRC(${A})GDBSRC\";\nstatic const char* const kJitKernelsSrc = R\"GDBSRC(${B})GDBSRC\";\n}  // namespace gdb\n")
